# MongoDB connection string for the backend database (FAISS vectors are also stored here)
MONGO_URI=mongodb://localhost:27017

# Name of the MongoDB database
DB_NAME=talentscan_db

# OpenRouter API key for LLM integration (Required for AI Analysis and RAG chat)
OPENROUTER_API_KEY=your-api-key

# The specific LLM model to use via OpenRouter
OPENROUTER_MODEL=your-ai-model

# Allowed CORS origins for the frontend (e.g., http://localhost:3000)
CORS_ORIGINS=*

# The port the FastAPI server will run on
PORT=8000

# Secret key used for signing JWT tokens (Change this in production)
JWT_SECRET=change_me_to_a_long_random_secret
